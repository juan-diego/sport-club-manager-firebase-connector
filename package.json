{
  "name": "@sport-club-manager/firebase-connector",
  "version": "0.1.0-dev.20260616053317388",
  "description": "Firebase connector package for the Sport Club Manager Angular frontend.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ngc -p tsconfig.lib.json && node ./scripts/verify-angular-metadata.mjs",
    "check:angular-metadata": "node ./scripts/verify-angular-metadata.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "artifactregistry-login": "npm_config_registry=https://registry.npmjs.org npx google-artifactregistry-auth --repo-config=./.npmrc",
    "prepublishOnly": "npm run build",
    "publish:artifactregistry": "npm run artifactregistry-login && npm publish --tag dev",
    "publish:verdaccio": "npm publish --registry http://127.0.0.1:4873/ --tag dev",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "registry": "https://europe-southwest1-npm.pkg.dev/xabalin-e8817/sport-club-manager-npm/"
  },
  "peerDependencies": {
    "@angular/core": "^20.2.0",
    "firebase": "^12.2.1",
    "rxjs": "~7.8.0",
    "@sport-club-manager/contracts": "0.1.0-dev.20260616053317388"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^20.2.0",
    "@angular/core": "^20.2.0",
    "firebase": "^12.2.1",
    "rxjs": "~7.8.0",
    "@sport-club-manager/contracts": "0.1.0-dev.20260616053317388",
    "typescript": "~5.9.2"
  }
}
